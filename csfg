<script>
(function(){
  if (window.__IMLEK_FIREWORK_UPGRADED__) return;
  window.__IMLEK_FIREWORK_UPGRADED__ = true;

  // Create / ensure root layer
  let layer = document.getElementById('firework-layer');
  if (!layer) {
    layer = document.createElement('div');
    layer.id = 'firework-layer';
    document.documentElement.appendChild(layer);
  }

  const COLORS = ['#ffd84a','#ff3b3b','#ffb000','#ffffff'];
  let intervalId = null;

  function explode(x, y, isBig){
    const COUNT = isBig ? 72 : 28;
    const RADIUS = isBig ? 260 : 120;

    for (let i = 0; i < COUNT; i++){
      const s = document.createElement('div');
      s.className = 'spark';

      const a = Math.random() * Math.PI * 2;
      const d = Math.random() * RADIUS * 0.5 + RADIUS * 0.5;
      const c = COLORS[Math.floor(Math.random() * COLORS.length)];

      s.style.left = x + 'px';
      s.style.top = y + 'px';
      s.style.color = c;
      s.style.background = c;
      s.style.setProperty('--x', Math.cos(a) * d + 'px');
      s.style.setProperty('--y', Math.sin(a) * d + 'px');

      layer.appendChild(s);
      s.addEventListener('animationend', () => s.remove(), { once:true });
    }
  }

  function spawn(){
    if (document.hidden) return;

    const w = window.innerWidth;
    const h = window.innerHeight;

    const startX = Math.random() * w;
    const startY = h + 80;               // start dari bawah layar
    const driftX = (Math.random() * 160 - 80);
    const endX = startX + driftX;
    const endY = Math.random() * h * 0.45 + 70;

    // Rotasi mengikuti arah (biar roket “menghadap” tujuan)
    const dx = endX - startX;
    const dy = endY - startY;
    const rot = Math.atan2(dy, dx) * 180 / Math.PI + 90; // +90 karena roket tegak

    const duration = Math.random() * 0.9 + 2.5;
    const isBig = Math.random() < 0.35;

    const r = document.createElement('div');
    r.className = 'rocket';

    // add trail & smoke
    const t = document.createElement('div');
    t.className = 'trail';
    const sm = document.createElement('div');
    sm.className = 'smoke';
    r.appendChild(t);
    r.appendChild(sm);

    r.style.setProperty('--sx', startX + 'px');
    r.style.setProperty('--sy', startY + 'px');
    r.style.setProperty('--ex', endX + 'px');
    r.style.setProperty('--ey', endY + 'px');
    r.style.setProperty('--rot', rot + 'deg');
    r.style.animationDuration = duration + 's';

    layer.appendChild(r);

    r.addEventListener('animationend', () => {
      // ledak tepat di titik akhir
      explode(endX, endY, isBig);
      r.remove();
    }, { once:true });
  }

  function start(){
    if (intervalId) return;
    intervalId = setInterval(spawn, 1200); // sedikit lebih rapat tapi tetap lega
  }

  function stop(){
    if (!intervalId) return;
    clearInterval(intervalId);
    intervalId = null;
    layer.querySelectorAll('.rocket,.spark').forEach(e => e.remove());
  }

  start();

  document.addEventListener('visibilitychange', () => {
    document.hidden ? stop() : start();
  });

  window.addEventListener('pagehide', stop);
})();
</script>

