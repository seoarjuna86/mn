                        var(--gold-bright) 30%,
                        transparent 35%,
                        transparent 70%,
                        var(--red-glow) 75%,
                        var(--gold-bright) 80%,
                        transparent 85%);
                animation: borderSpin 4s linear infinite;
                z-index: 1;
